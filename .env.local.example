# SOTERSA — variables de entorno
# Copiar a .env.local y llenar con los valores del proyecto de Supabase.
# .env.local NO se sube al repositorio.

# Panel de Supabase -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio: se salta TODAS las politicas RLS.
# Solo para el alta de usuarios desde el panel interno, y solo en el servidor.
# Si esta llave se filtra, se filtra la base entera.
SUPABASE_SERVICE_ROLE_KEY=
